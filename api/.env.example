[TEMPLATE]
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

OTP_DEMO_MODE=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# DATABASE  (PostgreSQL + PostGIS required)
# ---------------------------------------------------------------------------
# Render's standard PostgreSQL does NOT include PostGIS. This app's migrations
# enable the `postgis` extension and add a `geom` column for future radius
# search, so the database MUST be a PostGIS-capable instance (e.g. a Neon
# PostGIS database, or Render's PostGIS plan).
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=golestani
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# CACHE / SESSION / QUEUE  (Preview can run without Redis)
# ---------------------------------------------------------------------------
# Phase 1 (OTP / auth) only needs the Cache to store the hashed OTP. There is
# no real queue and no stateful session (auth is Bearer-token), so for a
# Redis-free Preview we use `database` / `database` / `sync` backed by the
# migrations already shipped (cache, sessions, jobs tables).
#
# PREVIEW (no Redis):   CACHE_STORE=database   SESSION_DRIVER=database   QUEUE_CONNECTION=database
# PRODUCTION (optional): switch to `redis` once a Redis instance is available.
CACHE_STORE=database
# CACHE_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis (only needed if you later switch CACHE/SESSION/QUEUE to `redis`).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX="golestani:"

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# SMS / OTP  (Preview demo — no real SMS provider connected)
# ---------------------------------------------------------------------------
# Keep `log` for Preview. A real Iranian provider will be wired through the
# existing SmsServiceInterface later — do NOT add provider credentials here.
SMS_DRIVER=log
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_API_KEY_HEADER=Authorization
SMS_GATEWAY_PHONE_FIELD=phone
SMS_GATEWAY_MESSAGE_FIELD=message
SMS_GATEWAY_TIMEOUT=10
SMS_GATEWAY_RETRIES=2
SMS_GATEWAY_RETRY_SLEEP=200

# OTP Demo mode — Preview ONLY.
#   Preview:   OTP_DEMO_MODE=true   (code is logged for the client to read)
#   Production: OTP_DEMO_MODE=false (default — the code is NEVER exposed even
#                                    if this is accidentally set to true)
OTP_DEMO_MODE=false

# ---------------------------------------------------------------------------
# CORS  (Preview / Production)
# ---------------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Leave empty for Preview
# (allows any origin, matches the current permissive behaviour). Lock to the
# deployed Vercel domain for Production:
#   CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=
