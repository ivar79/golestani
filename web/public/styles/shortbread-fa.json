{
  "version": 8,
  "name": "Iran Shortbread FA (Dark Aurora)",
  "metadata": {
    "maplibre:autogenerated": false,
    "description": "Shortbread 1.0 Vector Tiles Dark Theme for Iran with Persian Vazirmatn typography"
  },
  "glyphs": "/tiles/font/{fontstack}/{range}",
  "sources": {
    "shortbread": {
      "type": "vector",
      "url": "/tiles/basemap",
      "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap</a> contributors",
      "maxzoom": 14
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0e1726"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "land",
      "paint": {
        "fill-color": "#131f33"
      }
    },
    {
      "id": "land_greenery",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "land",
      "minzoom": 8,
      "filter": [
        "in",
        "kind",
        "park",
        "forest",
        "grass",
        "garden",
        "cemetery",
        "nature_reserve"
      ],
      "paint": {
        "fill-color": "#14432e",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "sites",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "sites",
      "minzoom": 10,
      "paint": {
        "fill-color": "#1a2538",
        "fill-opacity": 0.7
      }
    },
    {
      "id": "ocean",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "ocean",
      "paint": {
        "fill-color": "#12385c"
      }
    },
    {
      "id": "water_polygons",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "water_polygons",
      "paint": {
        "fill-color": "#12385c"
      }
    },
    {
      "id": "water_lines",
      "type": "line",
      "source": "shortbread",
      "source-layer": "water_lines",
      "minzoom": 6,
      "paint": {
        "line-color": "#12385c",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.6,
          14,
          3
        ]
      }
    },
    {
      "id": "boundaries_province",
      "type": "line",
      "source": "shortbread",
      "source-layer": "boundaries",
      "minzoom": 4,
      "filter": ["<=", ["to-number", ["get", "admin_level"]], 4],
      "paint": {
        "line-color": "#8b93a8",
        "line-width": 1,
        "line-dasharray": [3, 2],
        "line-opacity": 0.6
      }
    },
    {
      "id": "boundaries_country",
      "type": "line",
      "source": "shortbread",
      "source-layer": "boundaries",
      "minzoom": 2,
      "filter": ["<=", ["to-number", ["get", "admin_level"]], 2],
      "paint": {
        "line-color": "#a8b2c7",
        "line-width": 1.5,
        "line-opacity": 0.8
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "buildings",
      "minzoom": 13,
      "paint": {
        "fill-color": "#1d2c46",
        "fill-outline-color": "#283c5e"
      }
    },
    {
      "id": "streets_pedestrian",
      "type": "fill",
      "source": "shortbread",
      "source-layer": "streets_polygons",
      "minzoom": 13,
      "paint": {
        "fill-color": "#202e47",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "streets_minor",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "minzoom": 10,
      "filter": [
        "in",
        "kind",
        "minor_road",
        "medium_road",
        "track",
        "path",
        "service",
        "living_street"
      ],
      "paint": {
        "line-color": "#31435f",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          10,
          0.5,
          14,
          2.5,
          18,
          7
        ]
      }
    },
    {
      "id": "streets_major",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "minzoom": 7,
      "filter": ["==", "kind", "major_road"],
      "paint": {
        "line-color": "#4a608a",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          7,
          0.8,
          12,
          2.5,
          14,
          5,
          18,
          12
        ]
      }
    },
    {
      "id": "streets_highway",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "minzoom": 5,
      "filter": ["==", "kind", "highway"],
      "paint": {
        "line-color": "#c9d6f2",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          1,
          10,
          2.5,
          14,
          6,
          18,
          16
        ]
      }
    },
    {
      "id": "streets_highway_accent",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "minzoom": 13,
      "filter": ["in", "kind", "highway", "major_road"],
      "paint": {
        "line-color": "#22d3ee",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          0.8,
          18,
          2.5
        ],
        "line-opacity": 0.4
      }
    },
    {
      "id": "streets_rail",
      "type": "line",
      "source": "shortbread",
      "source-layer": "streets",
      "minzoom": 11,
      "filter": ["==", "kind", "rail"],
      "paint": {
        "line-color": "#5b5f7a",
        "line-width": 1.2,
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "water_lines_labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "water_lines_labels",
      "minzoom": 12,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Vazirmatn Medium", "Vazirmatn Regular"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#5b8ab8",
        "text-halo-color": "#0e1726",
        "text-halo-width": 2
      }
    },
    {
      "id": "street_labels",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "street_labels",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Vazirmatn Medium", "Vazirmatn Regular"],
        "text-size": 11
      },
      "paint": {
        "text-color": "#8ff3ff",
        "text-halo-color": "#0e1726",
        "text-halo-width": 2.5
      }
    },
    {
      "id": "place_labels_towns",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "place_labels",
      "minzoom": 9,
      "filter": [
        "in",
        "kind",
        "town",
        "village",
        "suburb",
        "neighbourhood"
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Vazirmatn Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          11,
          14,
          13
        ]
      },
      "paint": {
        "text-color": "#aab6cc",
        "text-halo-color": "#020617",
        "text-halo-width": 2
      }
    },
    {
      "id": "place_labels_cities",
      "type": "symbol",
      "source": "shortbread",
      "source-layer": "place_labels",
      "minzoom": 4,
      "filter": ["in", "kind", "country", "state", "city"],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "name_en"]],
        "text-font": ["Vazirmatn Bold", "Vazirmatn SemiBold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          12,
          10,
          16
        ]
      },
      "paint": {
        "text-color": "#e6edf8",
        "text-halo-color": "#020617",
        "text-halo-width": 2.5
      }
    }
  ]
}
