NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Map engine (resilient provider layer) ---
# Primary: Neshan Maps Platform SDK (hosted tiles, Persian labels).
# Get a free key at https://platform.neshan.org and put it here (client-side key).
# Without a key the map silently falls back to the Leaflet engine below —
# no fatal error is shown to users.
NEXT_PUBLIC_NESHAN_MAP_KEY=
# Neshan style name: dark | light | monochrome_light | monochrome_dark | pastel
# (or a full URL to a custom style JSON)
NEXT_PUBLIC_NESHAN_MAP_STYLE=dark
# Provider selection override: neshan | online | auto (unset = auto:
# neshan when the key exists, otherwise online). Runtime URL override:
# ?mapsource=neshan|online
# NEXT_PUBLIC_MAP_ENGINE=auto
# Fallback: Leaflet + independent raster tiles. Default is public OSM —
# check its usage policy (wiki.openstreetmap.org/wiki/Tile-usage-policy)
# before serving production traffic; point this at your own/licensed
# provider for high traffic (a Neshan raster style URL with a browser key
# also works and keeps the source independent of the Neshan *SDK*).
# NEXT_PUBLIC_LEAFLET_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=...
